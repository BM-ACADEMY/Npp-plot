# Server Port (Default for Npp-plot deployment is 6061; live NPP runs on 6060, ThePlotOne on 8200)
PORT=6061
NODE_ENV=production

# Database Connection URI (Must be configured per environment; do not run migrations or clean production data)
MONGO_URI=mongodb://localhost:27017/npp_plot_staging

# Frontend Client URL(s) - Supports single URL or comma-separated origins for CORS
CLIENT_URL=http://localhost:5173

# Scheduled Cron Jobs - Must remain 'false' unless explicitly approved to run property cleanups and lead matching
ENABLE_CRON_JOBS=false

JWT_SECRET=your_secure_jwt_secret_here

# Razorpay (Use test key for development/staging: rzp_test_...)
RAZORPAY_KEY_ID=rzp_test_FAKE_KEY_ID_00000000
RAZORPAY_KEY_SECRET=FAKE_RAZORPAY_SECRET_KEY_00000000

# Email (SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
USER_EMAIL=
USER_PASS=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# SMS API
BULKSMS_API_URL=
