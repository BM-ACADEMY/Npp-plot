# API Base URL for backend requests (e.g. http://localhost:6061/api or production domain)
VITE_API_URL=http://localhost:6061/api

# Client encryption secret (used for local storage caching)
VITE_SECRET_KEY=your_client_encryption_key_here

# Razorpay Key ID (Public key for checkout popup)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder
